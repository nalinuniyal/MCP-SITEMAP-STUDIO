# --- Supabase (required) -----------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
# NEXT_PUBLIC_* values are inlined at build time: set them before `npm run build`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Both are safe
# to expose to the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute URL used in auth emails (confirmation, password reset).
# Optional locally; set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider (Phase 4, not used yet) ---------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
